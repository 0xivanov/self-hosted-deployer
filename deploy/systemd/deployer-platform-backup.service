[Unit]
Description=Run the Self-Hosted Deployer platform backup
Documentation=https://github.com/0xivanov/self-hosted-deployer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/deployer/backup/offsite.env
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/deployer/backup-work /var/lib/deployer/backup-status
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ExecStartPre=/usr/bin/install -d -o root -g root -m 0700 /var/lib/deployer/backup-work /var/lib/deployer/backup-status
ExecStart=/usr/bin/python3 /usr/local/libexec/deployer-platform-backup.py --state-directory /var/lib/deployer/backup-status -- /usr/local/sbin/backup-platform-offsite.sh --server-binary /usr/local/bin/deployer-server --restic-binary /usr/local/bin/restic --database-path /var/lib/deployer/deployer.db --backup-key-file /etc/deployer/backup/platform-backup.key --work-root /var/lib/deployer/backup-work --environment legacy-vps

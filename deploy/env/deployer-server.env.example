# Copy to /etc/deployer/server.env and keep mode 0600.
DEPLOYER_SERVER_GRPC_ADDR=:7443
DEPLOYER_SERVER_HTTP_ADDR=:7080
DEPLOYER_DATABASE_URL=file:/var/lib/deployer/deployer.db
DEPLOYER_PUBLIC_BASE_URL=https://deploy.example.com:7443
DEPLOYER_SECRET_KEY=0123456789abcdef0123456789abcdef
DEPLOYER_TOKEN_HASH_KEY=replace-with-random-token-hash-key
DEPLOYER_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
DEPLOYER_INGRESS_NAMESPACE=deployer-apps
DEPLOYER_K3S_WIREGUARD_IP=10.8.0.1
DEPLOYER_K3S_NODE_TOKEN_PATH=/var/lib/rancher/k3s/server/node-token
DEPLOYER_WIREGUARD_INTERFACE=wg0
DEPLOYER_WIREGUARD_HUB_PUBLIC_KEY=replace-with-hub-public-key
DEPLOYER_WIREGUARD_ENDPOINT=deploy.example.com:51820
DEPLOYER_EVENT_RETENTION_MAX_AGE=720h
DEPLOYER_EVENT_RETENTION_MAX_COUNT=10000
DEPLOYER_EVENT_CLEANUP_INTERVAL=1h
DEPLOYER_NODE_OFFLINE_AFTER=2m
DEPLOYER_NODE_MONITOR_INTERVAL=30s

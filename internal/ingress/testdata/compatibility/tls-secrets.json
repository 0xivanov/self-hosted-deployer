{
  "deployment": {
    "metadata": {
      "name": "tls-api",
      "namespace": "deployer-apps",
      "creationTimestamp": null,
      "labels": {
        "app.kubernetes.io/managed-by": "deployer",
        "app.kubernetes.io/name": "tls-api",
        "deployer.io/app": "tls-api"
      }
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "tls-api",
          "deployer.io/app": "tls-api"
        }
      },
      "template": {
        "metadata": {
          "creationTimestamp": null,
          "labels": {
            "app.kubernetes.io/name": "tls-api",
            "deployer.io/app": "tls-api",
            "deployer.io/resilience-mode": "basic",
            "deployer.io/state-mode": "stateless"
          },
          "annotations": {
            "deployer.io/secret-hash": "fixture-secret-revision"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "tls-api",
              "image": "example/tls-api:3.1.0",
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8443
                }
              ],
              "env": [
                {
                  "name": "API_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "tls-api",
                      "key": "API_KEY"
                    }
                  }
                },
                {
                  "name": "DATABASE_URL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "tls-api",
                      "key": "DATABASE_URL"
                    }
                  }
                }
              ],
              "resources": {},
              "readinessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": 8443
                }
              }
            }
          ],
          "nodeSelector": {
            "kubernetes.io/arch": "arm64"
          }
        }
      },
      "strategy": {}
    },
    "status": {}
  },
  "ingress": {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "name": "tls-api",
      "namespace": "deployer-apps",
      "labels": {
        "app.kubernetes.io/managed-by": "deployer",
        "app.kubernetes.io/name": "tls-api",
        "deployer.io/app": "tls-api"
      },
      "annotations": {
        "cert-manager.io/cluster-issuer": "deployer-letsencrypt",
        "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
        "traefik.ingress.kubernetes.io/router.middlewares": "deployer-apps-tls-api@kubernetescrd",
        "traefik.ingress.kubernetes.io/router.tls": "true"
      }
    },
    "spec": {
      "ingressClassName": "traefik",
      "tls": [
        {
          "hosts": [
            "tls.example.test"
          ],
          "secretName": "tls-api-tls"
        }
      ],
      "rules": [
        {
          "host": "tls.example.test",
          "http": {
            "paths": [
              {
                "path": "/",
                "pathType": "Prefix",
                "backend": {
                  "service": {
                    "name": "tls-api",
                    "port": {
                      "number": 8443
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "secret": {
    "metadata": {
      "name": "tls-api",
      "namespace": "deployer-apps",
      "creationTimestamp": null,
      "labels": {
        "app.kubernetes.io/managed-by": "deployer",
        "app.kubernetes.io/name": "tls-api",
        "deployer.io/app": "tls-api"
      }
    },
    "data": {
      "API_KEY": "Zml4dHVyZS1hcGkta2V5",
      "DATABASE_URL": "Zml4dHVyZS1kYXRhYmFzZS11cmw="
    },
    "type": "Opaque"
  },
  "service": {
    "metadata": {
      "name": "tls-api",
      "namespace": "deployer-apps",
      "creationTimestamp": null,
      "labels": {
        "app.kubernetes.io/managed-by": "deployer",
        "app.kubernetes.io/name": "tls-api",
        "deployer.io/app": "tls-api"
      },
      "annotations": {
        "traefik.ingress.kubernetes.io/service.serverstransport": "deployer-apps-tls-api@kubernetescrd"
      }
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 8443,
          "targetPort": 8443
        }
      ],
      "selector": {
        "app.kubernetes.io/name": "tls-api",
        "deployer.io/app": "tls-api"
      },
      "type": "ClusterIP"
    },
    "status": {
      "loadBalancer": {}
    }
  }
}
